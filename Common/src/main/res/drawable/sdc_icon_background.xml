<?xml version="1.0" encoding="utf-8"?>
<!--
  SeanDexCo adaptive-icon background.

  Deep slate rather than a bright colour: this app is read at 3am, and a
  glowing launcher tile is hostile in a dark room. The subtle vertical
  gradient keeps it from looking flat next to Material You icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1B2430" />
                <item android:offset="1.0" android:color="#FF0E1218" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
